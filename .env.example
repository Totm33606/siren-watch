# SirenWatch environment template.
# `make up` copies this file to .env (never committed) if .env does not exist yet,
# and generates the two secrets left empty below. Edit .env, not this file.

# --- Airflow ------------------------------------------------------------------
# UID the Airflow containers run as. Linux: output of `id -u`. Windows/macOS: 50000.
AIRFLOW_UID=50000
# Admin account created on first start (http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Generated by `make up`. Signs the API server's authentication tokens.
# By hand: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
# Generated by `make up`. Encrypts the connections and variables stored by Airflow.
# By hand: openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=

# --- MinIO (local S3) ---------------------------------------------------------
# Console login (http://localhost:9001). Password: at least 8 characters, without
# @ : / (the MinIO client embeds it in a URL).
MINIO_ROOT_USER=sirenwatch
MINIO_ROOT_PASSWORD=sirenwatch-local

# --- Storage used by the pipeline ---------------------------------------------
SIRENWATCH_S3_BUCKET=sirenwatch
# Endpoint as seen from your machine; the containers use http://minio:9000 instead.
# Leave empty to use AWS S3.
SIRENWATCH_S3_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1
# S3 credentials read by boto3 and DuckDB. Locally: identical to the MinIO ones above.
# On AWS: the access keys of an IAM user.
AWS_ACCESS_KEY_ID=sirenwatch
AWS_SECRET_ACCESS_KEY=sirenwatch-local